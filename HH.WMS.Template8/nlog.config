<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Off">

  <!-- 日志根目录：logs/日期，例如 logs/2026-09-03 -->
  <variable name="logRoot" value="${basedir}/logs/${shortdate}" />

  <targets>
    <!-- 共享文件 Target：所有日志按 logger 名称自动分目录。
         业务日志通过 LogHelper.Info(msg,"NDC") / CreateLogger("NDC") 传入的名称
         即成为目录名，例：logs/2026-09-03/NDC/info.log
         新增业务名/后台任务名无需改配置，自动建目录。
         归档规则：单文件超 5MB 滚动为 {####}.txt，保留 7 天自动删除 -->
    <target name="BizFile" xsi:type="File"
            fileName="${logRoot}/${logger:shortName=true}/info.log"
            archiveFileName="${logRoot}/${logger:shortName=true}/info.{####}.txt"
            createDirs="true"
            autoFlush="true"
            keepFileOpen="false"
            archiveAboveSize="5242880"
            archiveNumbering="Sequence"
            archiveOldFileOnStartup="false"
            enableFileDelete="true"
            maxArchiveDays="7"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception: |${exception:format=tostring}}" />

    <!-- 全局错误汇总，保留 30 天 -->
    <target name="ErrorFile" xsi:type="File"
            fileName="${logRoot}/error/all_error.txt"
            archiveFileName="${logRoot}/error/info.{####}.txt"
            createDirs="true"
            autoFlush="true"
            keepFileOpen="false"
            archiveAboveSize="5242880"
            archiveNumbering="Sequence"
            archiveOldFileOnStartup="false"
            enableFileDelete="true"
            maxArchiveDays="30"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception: |${exception:format=tostring}}" />

    <target name="Console" xsi:type="Console"
            layout="${longdate}|${level:uppercase=true}|${logger:shortName=true}|${message}${onexception: |${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- 1. 系统/框架日志：不进业务文件，避免刷屏。
         Error+ 进全局错误文件；Warn 只进控制台；Info 及以下直接丢弃 -->
    <logger name="Microsoft.*" minlevel="Error" writeTo="ErrorFile,Console" final="true" />
    <logger name="Microsoft.*" minlevel="Warn" maxlevel="Warn" writeTo="Console" final="true" />
    <logger name="Microsoft.*" maxlevel="Info" final="true" />

    <!-- 2. 项目普通日志 Debug~Info：共享 BizFile，按日志名自动分目录，同时输出控制台 -->
    <logger name="*" minlevel="Debug" maxlevel="Info" writeTo="BizFile,Console" />

    <!-- 3. 项目 Error/Fatal：同时进业务目录 + 全局错误文件（控制台只打印一次） -->
    <logger name="*" minlevel="Error" writeTo="BizFile,ErrorFile,Console" />
  </rules>
</nlog>
